# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/apidb
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret (Base64 encoded 256-bit key or secure random string >= 32 characters)
JWT_SECRET=your_base64_or_32_char_jwt_secret_here

# Razorpay API Credentials (Test or Live)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Platform Commission Rate (0.10 = 10%)
PLATFORM_COMMISSION_RATE=0.10

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
